<div class="sdq-shell">
  <header class="sdq-header">
    <button type="button" class="sdq-secondary" data-action="sync" title="Получить актуальное состояние">Обновить</button>
    <img class="sdq-logo" src="modules/seven-dice-tavern-games/assets/seven-dice-logo.png" alt="Seven Dice">
    <div><span>ИГРЫ В ТАВЕРНЕ ОТ SEVEN DICE</span><h1>{{title}}</h1><p>{{subtitle}}</p></div>
    {{#if isDarts}}<i class="fa-solid fa-bullseye"></i>{{else}}<img class="sdq-game-art" src="modules/seven-dice-tavern-games/assets/baldur-dice.png" alt="Кости Балдура">{{/if}}
  </header>

  {{#unless hasTable}}
    {{#if otherTable}}
    <main class="sdq-empty"><h2>Уже идёт игра: {{otherTable}}</h2><button type="button" class="sdq-primary" data-action="returnTable">Вернуться к текущей партии</button></main>
    {{else}}
    {{#if isGM}}
    <main class="sdq-setup">
      <section><h2>Участники</h2>
        <div class="sdq-users">{{#each activeUsers}}<label><input type="checkbox" name="player" value="{{id}}" checked> {{name}}</label>{{/each}}</div>
      </section>
      <section><h2>NPC мастера</h2><div class="sd-npc-drop"><p>Перетащите актёра сюда</p><div class="sd-npc-list"></div></div><textarea name="npcs" rows="5" placeholder="Или введите имена вручную, по одному на строку"></textarea></section>
      <section><h2>Параметры</h2>
        <label>Ставка с участника<input type="text" name="stake" value="1 зм"></label>
        {{#if isDarts}}<label>Цель по очкам<input type="number" name="target" value="301" min="20"></label>{{/if}}
        <button type="button" class="sdq-primary" data-action="create"><i class="fa-solid fa-play"></i> Начать игру</button>
      </section>
    </main>
    {{else}}<main class="sdq-empty"><i class="fa-solid fa-hourglass"></i><h2>Мастер ещё не открыл стол</h2></main>{{/if}}
    {{/if}}
  {{else}}
  <main class="sdq-game">
    <section class="sdq-info"><div><span>СТАВКА</span><strong>{{state.stake}}</strong></div><div><span>БАНК</span><strong>{{state.pool}}</strong></div>{{#if isDarts}}<div><span>ЦЕЛЬ</span><strong>{{state.target}} очков</strong></div>{{/if}}{{#if isGM}}<button type="button" class="sdq-danger" data-action="reset">Закрыть стол</button>{{/if}}</section>
    <section class="sdq-players">
      {{#each state.participants}}
      <article class="{{#if active}}active{{/if}} {{#if winner}}winner{{/if}} {{#if bust}}bust{{/if}}">
        <span class="sdq-avatar">{{#if portrait}}<img src="{{portrait}}" alt="{{name}}">{{else}}{{initial}}{{/if}}</span>
        <div><strong>{{name}}</strong><span>{{status}}</span></div>
        {{#if ../isDarts}}<b>{{score}}</b><small>{{lastText}}</small>{{else}}<b>{{total}}</b><small>{{diceText}}</small>{{/if}}
        {{#if ../isDarts}}<progress value="{{progress}}" max="100" aria-label="Прогресс {{name}}"></progress><small>До цели: {{remaining}}</small>{{/if}}
        {{#if offline}}<small>Не в сети</small>{{#if ../isGM}}<button data-action="reclaim" data-participant-id="{{id}}">Принять управление</button>{{/if}}{{/if}}
      </article>
      {{/each}}
    </section>
    {{#if state.finished}}
    <section class="sdq-result"><i class="fa-solid fa-trophy"></i><div class="sdq-winners">{{#each state.participants}}{{#if winner}}<article><span class="sdq-avatar">{{#if portrait}}<img src="{{portrait}}" alt="">{{else}}{{initial}}{{/if}}</span><h2>{{name}}</h2>{{#if ../isDarts}}<strong>{{score}} очков</strong>{{else}}<strong>{{diceText}} = {{total}}</strong>{{/if}}</article>{{/if}}{{/each}}</div><h2>{{state.resultText}}</h2><p>Общий банк: <strong>{{state.pool}}</strong></p>{{#if isGM}}<button class="sdq-primary" data-action="replay">Сыграть ещё раз</button>{{/if}}</section>
    {{/if}}
    <section class="sdq-board">
      {{#unless state.finished}}<span>{{#if controls}}ВАШ ХОД{{else}}ХОД УЧАСТНИКА{{/if}}</span><h2>{{active.name}}</h2>{{/unless}}
      {{#if isDarts}}
        <div class="sdq-darts-layout">
          <div class="sdq-target-wrap">
            <div class="sdq-target board-{{dartboardStyle}} {{#if dartsVisual}}hit-{{dartsVisual.hit}}{{/if}}">
              {{#each targetSectors}}<span class="sdq-sector-number" style="{{style}}">{{number}}</span>{{/each}}
              <div class="sdq-ring sdq-ring-outer"></div><div class="sdq-ring sdq-ring-triple"></div><div class="sdq-ring sdq-ring-inner"></div><div class="sdq-bull"></div>
              {{#if dartsVisual.highlight}}<svg class="sdq-hit-sector" viewBox="0 0 100 100" aria-hidden="true"><path d="{{dartsVisual.highlight}}"/></svg>{{/if}}
              {{#if dartsVisual}}<div class="sdq-dart-marker" style="{{dartsVisual.markerStyle}}"><i></i></div>{{/if}}
            </div>
          </div>
          <div class="sdq-darts-panel">
            <div class="sdq-board-switch"><span>Вид мишени</span><div>{{#each dartboardStyles}}<button type="button" class="{{#if active}}active{{/if}}" data-action="boardStyle" data-board-style="{{id}}">{{label}}</button>{{/each}}</div></div>
            <details class="sdq-darts-rule" {{#if rulesExpanded}}open{{/if}}>
              <summary><i class="fa-solid fa-circle-info"></i> Как начисляются очки</summary>
              <div class="sdq-darts-rule-body">
                <p><b>d20</b> определяет номер сектора мишени: от 1 до 20.</p>
                <ul>
                  <li><b>d6: 1–2 — внешняя область.</b> Номер сектора ×1. Например, сектор 5 даёт 5 очков.</li>
                  <li><b>d6: 3–4 — внутреннее кольцо.</b> Номер сектора ×2. Например, сектор 5 даёт 10 очков.</li>
                  <li><b>d6: 5 — тройное кольцо.</b> Номер сектора ×3. Например, сектор 5 даёт 15 очков.</li>
                  <li><b>d6: 6 — яблочко.</b> Всегда даёт 50 очков независимо от d20.</li>
                </ul>
              </div>
            </details>
            {{#if dartsVisual}}<div class="sdq-hit-result"><small>{{dartsVisual.participantName}}</small><strong>+{{dartsVisual.points}}</strong><b>{{dartsVisual.equation}}</b><span>Сектор {{dartsVisual.sector}} · {{dartsVisual.label}}</span></div>{{/if}}
          </div>
        </div>
      {{else}}
        {{#unless state.finished}}
        <div class="sdq-total"><small>ТЕКУЩАЯ СУММА</small><strong>{{active.total}} / 21</strong><span>{{#if active.started}}{{active.diceText}} = {{active.total}}{{else}}Кости ещё не брошены{{/if}}</span><p>До 21: {{active.remaining}} очков</p></div>
        <div class="sdq-dice-tray">{{#each active.diceFaces}}<span class="sdq-die-face {{#if newest}}newest{{/if}}" aria-label="Кость {{value}}">{{face}}<small>{{value}}</small></span>{{/each}}</div>
        {{#unless controls}}<p class="sdq-wait">Ожидание решения…</p>{{/unless}}
        {{/unless}}
      {{/if}}
    </section>
  </main>
  {{#unless state.finished}}<footer class="sdq-fixed-actions">{{#if isDarts}}            {{#unless state.finished}}{{#if controls}}<button type="button" class="sdq-primary sdq-big" data-action="dartsRoll" data-participant-id="{{active.id}}"><i class="fa-solid fa-bullseye"></i> Бросить дротик</button>{{else}}<p class="sdq-wait">Ожидание броска…</p>{{/if}}{{/unless}}{{else}}        {{#if canInitialRoll}}<button type="button" class="sdq-primary sdq-big" data-action="baldurRoll" data-participant-id="{{active.id}}"><i class="fa-solid fa-dice"></i> Бросить начальные 2d6</button>{{/if}}        {{#if canBaldurChoose}}<div class="sdq-actions"><button type="button" class="sdq-primary" data-action="baldurHit" data-participant-id="{{active.id}}"><i class="fa-solid fa-plus"></i> Добавить кость</button><button type="button" class="sdq-secondary" data-action="baldurStand" data-participant-id="{{active.id}}"><i class="fa-solid fa-hand"></i> Остановиться на {{active.total}}</button></div>{{/if}}{{#unless controls}}<span>Ждём решения участника</span>{{/unless}}{{/if}}</footer>{{/unless}}
  {{/unless}}
</div>
